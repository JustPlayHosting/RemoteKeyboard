<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#1A1A2E">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Keyboard Mode"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Target Phone (paired)"
        android:textSize="12sp"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="4dp"/>

    <Spinner
        android:id="@+id/deviceSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#333355"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/noDevicesHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No paired devices. Pair in Android Bluetooth Settings first."
        android:textColor="#FF6B6B"
        android:textSize="12sp"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect"
        android:backgroundTint="#3A86FF"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Not connected"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginBottom="32dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="On the target phone:"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1. Enable 'Remote Keyboard' in IME settings\n2. Set it as active keyboard\n3. Tap any text field\n4. Keystrokes will appear there"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnImeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show Hint"
        android:backgroundTint="#444444"/>

</LinearLayout>
  
